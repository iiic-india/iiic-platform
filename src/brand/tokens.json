{
  "$schema": "IIIC brand tokens 1.0.3 · exported from css/01-tokens.css and css/02-semantic.css for tools that cannot read CSS variables (email, print, PowerPoint, Word, Figma, admin theming). The CSS is the source of truth; keep this in sync.",
  "version": "1.0.3",
  "principle": "Two colours come from the logo: Yellow #FFDD00 and Slate #43525A. Yellow lives on paper, white or its own tints, never on a dark surface; it is a fill or the bar, never text and never a thin line; and nothing dark is filled next to yellow (on yellow, the accent and the primary button are white). Dark tones are ink for type and the illustration, not backgrounds.",
  "color": {
    "yellow": "#FFDD00",
    "slate": "#43525A",
    "yellowDeep": "#E8C800",
    "yellow200": "#FFE866",
    "yellow100": "#FFF3B0",
    "yellow050": "#FFFAE0",
    "yellowText": "#5C4E00",
    "paper": "#F8F6F0",
    "paper2": "#EFEBE1",
    "white": "#FFFFFF",
    "ink": "#1C262B",
    "slate500": "#5E6C74",
    "slate400": "#7A868C",
    "slate300": "#A9B4B9",
    "mist": "#E4E8EA",
    "mist050": "#EEF2F3",
    "lineWarm": "rgba(28,38,43,.12)",
    "lineOnYellow": "rgba(28,38,43,.22)",
    "scrim": "rgba(28,38,43,.45)",
    "success": "#1E6F57",
    "success050": "#EAF5EF",
    "danger": "#B3261E",
    "danger050": "#FBEDEB",
    "danger100": "#F7DDD9",
    "note": "Caution uses the yellow family; there is no separate warning colour. Status colours are for alerts only. Yellow is a fill or the bar (4px or wider), never text and never a thinner line. slate400 is the control-border colour (3.1:1 or better on every light surface); slate300 is decorative only."
  },
  "font": {
    "display": "var(--font-fraunces, Fraunces), \"Noto Serif Gujarati\", \"Noto Serif Devanagari\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
    "text": "var(--font-manrope, Manrope), \"Noto Sans Gujarati\", \"Noto Sans Devanagari\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Consolas, monospace",
    "emailDisplay": "Georgia, 'Times New Roman', serif",
    "emailText": "Arial, Helvetica, sans-serif",
    "officeDisplay": "Georgia",
    "officeText": "Arial",
    "files": "fonts/ (self-hosted variable woff2, SIL Open Font License 1.1, loaded by css/00-fonts.css). The Latin files include the rupee sign (U+20B9).",
    "note": "Fraunces and Manrope are the web and print faces and ship with the kit. Email clients and most Office installs do not have them, so email and PowerPoint use Georgia and Arial. If the team installs the fonts on every machine, change the PowerPoint theme fonts to Fraunces and Manrope.",
    "frameworkHook": "If the app loads the same Latin files with next/font and exposes --font-fraunces and --font-manrope on <html>, the kit's stacks use them; otherwise they fall back to the @font-face families. Nothing in the kit is redefined."
  },

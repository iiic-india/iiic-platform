# IIIC platform · environment variables
# Copy to .env for local development. Real values live in Vercel (Preview and Production) and a password manager.
# Never commit .env. Every variable used in code must be listed here.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # platform origin: https://imagecatalysts.in in Production (D-05); leave unset on Vercel Preview, where each deployment uses its own URL
NEXT_PUBLIC_INSTITUTE_URL=                         # Release 3: https://iiic.edu.in
PLATFORM_HOSTS=localhost:3000                      # comma-separated hosts routed to the platform
INSTITUTE_HOSTS=                                   # Release 3: iiic.edu.in,www.iiic.edu.in
TZ_DISPLAY=Asia/Kolkata
# Set by Vercel on every deployment, read by src/lib/env.ts (never set by hand):
# VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_GIT_COMMIT_SHA

# --- Payload and database ---
PAYLOAD_SECRET=                                    # 32+ random bytes
PAYLOAD_SECRET_PREVIOUS=                           # only while rotating PAYLOAD_SECRET: the value it replaced (docs/08 §9); removed afterwards
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iiic   # Supabase pooled connection string in Preview/Production
DATABASE_URL_DIRECT=                               # Supabase session pooler (port 5432, IPv4), used for migrations; the transaction pooler (6543) goes in DATABASE_URL
OWNER_SETUP_TOKEN=                                 # Production servers only, while creating the first owner: 32+ base64url characters (README), open /api/owner-setup?token=<value>, then delete the variable (D-41)

# --- Jobs ---
CRON_SECRET=                                       # 32+ characters; Vercel Cron sends it as a bearer token to /api/cron/jobs (docs/19 §2). Without it the route answers 503

# --- Storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=iiic-media
R2_BUCKET_PRIVATE=iiic-documents
R2_PUBLIC_BASE_URL=                                # the public bucket's own address: https://media.imagecatalysts.in in Vercel (D-46)

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=                                   # rzp_test_… locally and in Preview
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY=razorpay                           # "fake" only locally and in CI: the in-memory gateway for tests; refused on any Vercel deployment (docs/16 §11)

# --- Invoicing (Zoho Books, India data centre: zohoapis.in) ---
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=https://www.zohoapis.in/books/v3

# --- Email (Resend) ---
RESEND_API_KEY=                                    # without it, email is dropped with a note in the log (D-47)
EMAIL_FROM_ADDRESS=onboarding@resend.dev           # Resend's shared sender, for development; Vercel sets platform@notify.imagecatalysts.in (D-47)
RESEND_WEBHOOK_SECRET=                             # whsec_…, the signing secret of the webhook to /api/webhooks/resend (docs/19 §4)
MAIL_DOMAIN=                                       # imagecatalysts.in in Production: sends from bookings@ / hello@ / platform@notify. and journal@news., replies to the role inboxes (docs/13 §1). Empty: everything from EMAIL_FROM_ADDRESS
MESSAGING_TRANSPORT=live                           # "fake" only locally and in CI: in-memory email and WhatsApp senders; refused on any Vercel deployment (docs/19 §3)

# --- WhatsApp (AiSensy, D-06): all three together, or none, and messages go by email ---
WHATSAPP_PROVIDER=aisensy
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=                           # 32+ characters, checked on /api/webhooks/whatsapp (docs/19 §4)
WHATSAPP_SENDER_NUMBER=                            # E.164, from I-03

# --- Google Workspace calendar sync (D-22, D-23) ---
GOOGLE_WORKSPACE_DOMAIN=                           # the platform domain on Google Workspace
GOOGLE_SERVICE_ACCOUNT_EMAIL=                      # service account with domain-wide delegation, Calendar scope only
GOOGLE_SERVICE_ACCOUNT_KEY=                        # its private key (JSON, base64); never committed
GOOGLE_CALENDAR_WEBHOOK_TOKEN=                     # verifies calendar change notifications (B14)
# Per-practitioner OAuth instead of delegation (only if IIIC prefers it):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Security ---
NOTES_ENCRYPTION_KEY=                              # 32-byte key (openssl rand -base64 32) for session notes; unset, notes are refused (docs/18 §3)
NOTES_ENCRYPTION_KEY_PREVIOUS=                     # only while rotating NOTES_ENCRYPTION_KEY: the key it replaced; removed once notes are re-encrypted
TOKEN_SIGNING_SECRET=                              # signs manage-booking, feedback and confirmation links
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Logs (D-17) ---
LOG_DRAIN_SECRET=                                  # verifies Vercel log drain requests if the drain is self-hosted
LOG_STORE_URL=
LOG_STORE_TOKEN=

# --- Monitoring and analytics ---
SENTRY_DSN=                                        # error reports (server-side only, D-49); Vercel's Sentry integration sets NEXT_PUBLIC_SENTRY_DSN instead, and either works
SENTRY_AUTH_TOKEN=                                 # build-time only: records each deployment as a release; set by the integration with SENTRY_ORG and SENTRY_PROJECT
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
UPTIME_HEARTBEAT_URL=                              # the cron runner pings it on every run (12 §7)

# --- Search and sharing (12 §3) ---
SEARCH_INDEXING=                                   # "on" in Vercel's Production environment at launch, and only then: until it is set, every route sends noindex (D-50)
INDEXNOW_KEY=                                      # Bing IndexNow; the key file is served at /<key>.txt
NEXT_PUBLIC_INSTITUTE_URL=                         # https://iiic.edu.in once live (R3); the platform origin is NEXT_PUBLIC_SITE_URL above

# --- Release 2 ---
# Customer sign-in (docs/20-accounts-design.md). Better Auth's base URL is the site's own origin
# (NEXT_PUBLIC_SITE_URL, or Vercel's), so BETTER_AUTH_URL is not used.
BETTER_AUTH_SECRET=                                # 32+ random characters per environment (openssl rand -base64 32); unset, sign-in is closed. Rotating it signs every customer out
BETTER_AUTH_TELEMETRY=                             # leave unset: any value but 0 or false is refused (no usage reports to Better Auth)
ACCOUNTS_TEST_CODE=                                # six digits, locally and in CI only: every sign-in code is this one, for the end-to-end suite; refused on any Vercel deployment
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
# SMS one-time codes only if D-08 chooses SMS (requires TRAI DLT registration first)
SMS_PROVIDER=
SMS_API_KEY=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID_OTP=

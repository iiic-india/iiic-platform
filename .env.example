# IIIC platform · environment variables
# Copy to .env for local development. Real values live in Vercel (Preview and Production) and a password manager.
# Never commit .env. Every variable used in code must be listed here.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # platform origin, e.g. https://iiic.works (D-05); leave unset on Vercel Preview, where each deployment uses its own URL
NEXT_PUBLIC_INSTITUTE_URL=                         # Release 3: https://iiic.edu.in
PLATFORM_HOSTS=localhost:3000                      # comma-separated hosts routed to the platform
INSTITUTE_HOSTS=                                   # Release 3: iiic.edu.in,www.iiic.edu.in
TZ_DISPLAY=Asia/Kolkata
# Set by Vercel on every deployment, read by src/lib/env.ts (never set by hand):
# VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_GIT_COMMIT_SHA

# --- Payload and database ---
PAYLOAD_SECRET=                                    # 32+ random bytes
PAYLOAD_SECRET_PREVIOUS=                           # only while rotating PAYLOAD_SECRET: the value it replaced (docs/08 §9); removed afterwards
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iiic   # Supabase pooled connection string in Preview/Production
DATABASE_URL_DIRECT=                               # Supabase session pooler (port 5432, IPv4), used for migrations; the transaction pooler (6543) goes in DATABASE_URL
OWNER_SETUP_TOKEN=                                 # Production servers only, while creating the first owner: 32+ base64url characters (README), open /api/owner-setup?token=<value>, then delete the variable (D-41)

# --- Jobs ---
CRON_SECRET=                                       # Vercel Cron sends this as a bearer token to /api/cron/jobs

# --- Storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=iiic-media
R2_BUCKET_PRIVATE=iiic-documents
R2_PUBLIC_BASE_URL=                                # custom domain for the public bucket, e.g. https://media.iiic.works

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=                                   # rzp_test_… locally and in Preview
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Invoicing (Zoho Books, India data centre: zohoapis.in) ---
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=https://www.zohoapis.in/books/v3

# --- Email (Resend) ---
RESEND_API_KEY=                                    # without it, email is dropped with a note in the log (D-47)
EMAIL_FROM_ADDRESS=onboarding@resend.dev           # Resend's shared sender until the platform domain is verified (D-05)
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_TRANSACTIONAL="IIIC <hello@notify.example>"   # set to the real subdomain after D-05
EMAIL_FROM_NEWSLETTER="IIIC Journal <journal@news.example>"
EMAIL_REPLY_TO=
RESEND_AUDIENCE_ID=                                # newsletter audience (D-10)

# --- WhatsApp (provider API, D-06) ---
WHATSAPP_PROVIDER=aisensy
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_SENDER_NUMBER=                            # E.164, from I-03

# --- Google Workspace calendar sync (D-22, D-23) ---
GOOGLE_WORKSPACE_DOMAIN=                           # the platform domain on Google Workspace
GOOGLE_SERVICE_ACCOUNT_EMAIL=                      # service account with domain-wide delegation, Calendar scope only
GOOGLE_SERVICE_ACCOUNT_KEY=                        # its private key (JSON, base64); never committed
GOOGLE_CALENDAR_WEBHOOK_TOKEN=                     # verifies calendar change notifications (B14)
# Per-practitioner OAuth instead of delegation (only if IIIC prefers it):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Security ---
NOTES_ENCRYPTION_KEY=                              # 32-byte key (base64) for session notes; rotate per runbook
TOKEN_SIGNING_SECRET=                              # signs manage-booking, feedback and confirmation links
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Logs (D-17) ---
LOG_DRAIN_SECRET=                                  # verifies Vercel log drain requests if the drain is self-hosted
LOG_STORE_URL=
LOG_STORE_TOKEN=

# --- Monitoring and analytics ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                                 # build-time only, for source maps
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
UPTIME_HEARTBEAT_URL=                              # the cron runner pings it on every run (12 §7)

# --- Search and sharing (12 §3) ---
INDEXNOW_KEY=                                      # Bing IndexNow; the key file is served at /<key>.txt
NEXT_PUBLIC_INSTITUTE_URL=                         # https://iiic.edu.in once live (R3); the platform origin is NEXT_PUBLIC_SITE_URL above

# --- Release 2 ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
# SMS one-time codes only if D-08 chooses SMS (requires TRAI DLT registration first)
SMS_PROVIDER=
SMS_API_KEY=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID_OTP=
